{
  "name": "my-tube",
  "version": "3.0.0",
  "description": "A simple YouTube video and audio downloader.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "youtube",
    "downloader",
    "audio",
    "video",
    "electron"
  ],
  "author": "Bxthesda <lucien.schaeffer@hotmail.com>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-store": "^8.2.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "build": {
    "appId": "com.example.ytdownloader",
    "productName": "MyTube",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.flatpak-builder{,/**}",
      "!dist{,/**}",
      "!builddir{,/**}"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "maintainer": "Bxthesda <lucien.schaeffer@hotmail.com>",
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "desktop": {
        "Name": "MyTube",
        "Comment": "YouTube video and audio downloader",
        "Keywords": "youtube;downloader;video;audio;mp3;mp4",
        "StartupWMClass": "mytube"
      }
    },
    "asarUnpack": [
      "**/node_modules/yt-dlp-wrap/bin/**"
    ],
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "22.08",
      "sdk": "org.freedesktop.Sdk",
      "finishArgs": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications"
      ]
    }
  }
}
