{
  "name": "my-tube",
  "version": "2.0.0",
  "description": "A simple YouTube video and audio downloader.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "youtube",
    "downloader",
    "audio",
    "video",
    "electron"
  ],
  "author": "Bxthesda <lucien.schaeffer@hotmail.com>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "electron-store": "^8.2.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "build": {
    "appId": "com.example.ytdownloader",
    "productName": "MyTube",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Bxthesda <lucien.schaeffer@hotmail.com>",
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "desktop": {
        "Name": "MyTube",
        "Comment": "A simple YouTube video and audio downloader",
        "Keywords": "youtube;downloader;video;audio;",
        "StartupWMClass": "MyTube"
      },
      "executableName": "MyTube"
    },
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/**/ffmpeg*",
      "**/node_modules/@ffmpeg-installer/**/*",
      "**/node_modules/yt-dlp-wrap/bin/**"
    ]
  }
}
